{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@lib/*": ["./lib/*"]
    },
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "lib/**/*.ts", "test/**/*.ts", "prisma*.config.ts"],
  "exclude": ["node_modules", "dist"]
}

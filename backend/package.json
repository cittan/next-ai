{
  "name": "next-ai-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @next-ai/contracts build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "dev:express": "tsx watch src/server.ts",
    "build:express": "pnpm --filter @next-ai/contracts build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start:express": "node dist/src/server.js",
    "dev:worker": "tsx watch src/workers/document.worker.ts",
    "start:worker": "node dist/src/workers/document.worker.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.express.json",
    "vitest": "vitest"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.14.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.1.49",
    "@langchain/langgraph": "^1.4.2",
    "@langchain/openai": "^1.4.7",
    "@langchain/textsplitters": "^1.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "langchain": "^1.4.5",
    "mammoth": "^1.8.0",
    "minio": "^8.0.1",
    "nanoid": "^5.0.7",
    "next": "^15.5.19",
    "openai": "^4.60.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^10.0.0",
    "zod": "^4.4.3",
    "@next-ai/contracts": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^7.8.0",
    "typescript": "^5.5.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}

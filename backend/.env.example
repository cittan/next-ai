# 应用配置
APP_PORT=3000
APP_ENV=development

# PostgreSQL 主数据库配置（用于 Prisma ORM）
PGSQL_HOST=localhost
PGSQL_PORT=5432
PGSQL_DATABASE=next_ai_business
PGSQL_USER=postgres
PGSQL_PASSWORD=your-password
PGSQL_MAX_POOL_SIZE=10

# PostgreSQL + pgvector 向量数据库配置
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=next_ai_vector
PG_SCHEMA=public
PG_USER=postgres
PG_PASSWORD=your-password
PG_POOL_NAME=super-agent-pgvector-pool
PG_MAX_POOL_SIZE=10
PG_MIN_IDLE=2

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TIMEOUT=3000

# Elasticsearch 配置
ES_URIS=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
ELASTICSEARCH_INDEX_NAME=super_agent_business_chat
ELASTICSEARCH_NAVIGATION_INDEX_NAME=super_agent_business_chat_navigation
ELASTICSEARCH_ROUTE_INDEX_NAME=super_agent_business_chat_route
ELASTICSEARCH_ANALYZER=ik_max_word
ELASTICSEARCH_SEARCH_ANALYZER=ik_max_word
ELASTICSEARCH_CONNECT_TIMEOUT=3000
ELASTICSEARCH_SOCKET_TIMEOUT=3000

# MinIO 配置
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET_NAME=super-agent-business-chat
MINIO_OBJECT_PREFIX=super-agent-business-chat/
MINIO_PARSED_TEXT_PREFIX=super-agent-business-chat/parsed_text/

# 管理员配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
ADMIN_TOKEN_SECRET=your-jwt-secret
ADMIN_TOKEN_EXPIRE_MINUTES=720

# AI 配置
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-api-key
AI_CHAT_MODEL=gpt-3.5-turbo
AI_EMBEDDING_MODEL=text-embedding-ada-002
AI_TEMPERATURE=0.5
AI_MAX_TOKENS=5000

# Tavily 搜索配置
TAVILY_ENABLED=true
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_PATH=/search
TAVILY_API_KEY=your-tavily-api-key
TAVILY_TOPIC=general
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5
TAVILY_INCLUDE_ANSWER=true
TAVILY_INCLUDE_RAW_CONTENT=false

# Kafka 配置
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=super-agent-group
KAFKA_PARSE_TOPIC=document-parse
KAFKA_INDEX_TOPIC=document-index
KAFKA_AUTO_CREATE_TOPICS=true

# RAG 配置
RAG_ENABLED=true
RAG_REWRITE_ENABLED=true
RAG_REWRITE_HISTORY_TURNS=3
RAG_MAX_SUB_QUESTIONS=3
RAG_VECTOR_TOP_K=8
RAG_KEYWORD_TOP_K=8
RAG_CANDIDATE_TOP_K=10
RAG_FINAL_TOP_K=5
RAG_MIN_VECTOR_SIMILARITY=0.45
RAG_KEYWORD_RELATIVE_SCORE_FLOOR=0.35
RAG_PARENT_EVIDENCE_MAX_CHARS=2200
RAG_PLANNING_HISTORY_MAX_CHARS=3000
RAG_ANSWER_HISTORY_MAX_CHARS=3000
RAG_TOTAL_EVIDENCE_MAX_CHARS=5200
RAG_PER_SUB_QUESTION_EVIDENCE_MAX_CHARS=2600
RAG_NO_EVIDENCE_REPLY=未找到相关信息
RAG_ANSWER_SYSTEM_PROMPT=你是一个基于知识库的智能问答助手。请根据提供的参考信息，准确、简洁地回答用户的问题。如果参考信息不足以回答问题，请如实告知用户。请使用中文回答，并引用相关信息来源。
RAG_KEYWORD_CHANNEL_ENABLED=true
RAG_RERANK_ENABLED=false
RAG_CHANNEL_TIMEOUT_MS=10000
RAG_SUB_QUESTION_TIMEOUT_MS=30000

# RAG 历史摘要配置
RAG_HISTORY_SUMMARY_ENABLED=true
RAG_HISTORY_SUMMARY_KEEP_RECENT_TURNS=2
RAG_HISTORY_SUMMARY_COMPRESSION_BATCH_TURNS=10
RAG_HISTORY_SUMMARY_MAX_CHARS=1000
RAG_HISTORY_SUMMARY_RECENT_TRANSCRIPT_MAX_CHARS=2000

# RAG 改写选项配置
RAG_REWRITE_OPTIONS_ENABLED=false
RAG_REWRITE_OPTIONS_TEMPERATURE=0.7
RAG_REWRITE_OPTIONS_TOP_P=0.9
RAG_REWRITE_OPTIONS_THINKING=false

# Rerank 配置
RERANK_ENABLED=false
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TOP_N=5
RERANK_CONNECT_TIMEOUT_MS=5000
RERANK_READ_TIMEOUT_MS=30000
